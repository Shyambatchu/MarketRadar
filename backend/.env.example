SERPAPI_API_KEY=
DATABASE_URL=sqlite:///./data/market_radar.db
FRONTEND_URL=http://localhost:5173
# Comma-separated origins the API accepts browser requests from.
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://127.0.0.1:5173,http://127.0.0.1:5174

# AI Analyst (optional). Without these the analyst returns its deterministic
# factual analysis and lists the evidence relevant to a question.
# The bundled adapter is "anthropic" (Claude); AI_MODEL defaults to claude-opus-5-5.
AI_PROVIDER=
AI_API_KEY=
AI_MODEL=

# Optional cap on live SerpApi searches per calendar month (UTC). Leave empty
# to rely on SerpApi's own account quota. Cached results are always served.
SERPAPI_MONTHLY_BUDGET=
# Optional cost-estimate inputs. When empty, the plan reported by SerpApi's
# account endpoint is priced from the published table (see usage_service.py).
SERPAPI_PLAN_MONTHLY_PRICE_USD=
SERPAPI_PLAN_SEARCHES_PER_MONTH=

# Price change detection thresholds (overridable per request).
PRICE_CHANGE_MIN_PERCENT=5.0
PRICE_OUTLIER_MAD_K=3.5
PRICE_OUTLIER_MIN_MERCHANTS=4
PRICE_DISPERSION_MIN_PERCENT=25.0

# Opportunity score weights (normalised to sum to 1) and freshness half-life.
OPPORTUNITY_WEIGHT_IMPACT=0.40
OPPORTUNITY_WEIGHT_CONFIDENCE=0.30
OPPORTUNITY_WEIGHT_FRESHNESS=0.15
OPPORTUNITY_WEIGHT_RELEVANCE=0.15
OPPORTUNITY_FRESHNESS_HALF_LIFE_DAYS=14
